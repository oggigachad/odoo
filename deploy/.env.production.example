# Copy to deploy/.env.production on the server. NEVER commit the filled-in file.
# Generate secrets with:  openssl rand -hex 32

# --- where it runs ---
API_DOMAIN=api.example.com                 # DNS A record -> this server's IP
FRONTEND_URL=https://skyline.example.com   # the Vercel/Netlify site (event QR codes and e-mail links point here)
CORS_ORIGINS=                              # extra allowed sites, comma separated (e.g. the *.vercel.app preview URL)

# --- data stores (inside the Docker network) ---
POSTGRES_USER=skyline
POSTGRES_PASSWORD=
POSTGRES_DB=skyline
REDIS_PASSWORD=
MINIO_ROOT_USER=skyline_media
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=skyline-media

# --- secrets (32+ random characters each, all different) ---
JWT_SECRET=
TICKET_SIGNING_SECRET=

# --- first Admin (created on first start; production refuses the default password) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# --- sign-up rules ---
STUDENT_EMAIL_DOMAINS=gmail.com,student.edu.in
ADMIN_EMAIL_DOMAINS=yourdomain.com

# --- e-mail (Gmail needs an App Password; port 465 = implicit TLS) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP2_USER=
SMTP2_PASSWORD=

# --- reliable e-mail over HTTPS (recommended on a home or campus network where SMTP is filtered): use ONE of these ---
BREVO_API_KEY=                             # brevo.com: free plan, verify EMAIL_FROM as a sender
RESEND_API_KEY=                            # resend.com
MAIL_RELAY_URL=                            # or the Google Apps Script web app that sends from your Gmail (see DEPLOY.md)
MAIL_RELAY_TOKEN=
SMTP_FALLBACK_PORT=                        # optional: port tried when SMTP_PORT fails (default: 587 or 465)

# --- payments (switch to live keys; webhook URL: https://<API_DOMAIN>/api/v1/webhooks/razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# --- optional ---
GOOGLE_CLIENT_ID=
