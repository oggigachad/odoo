# Application Environment (development, test, staging, production)
APP_ENV=development

# Database configuration
DATABASE_URL=postgresql+asyncpg://sos:sos@localhost:5432/sos_dev
SYNC_DATABASE_URL=postgresql://sos:sos@localhost:5432/sos_dev

# Backend security secrets
JWT_SECRET=super-secret-development-jwt-token-replace-in-production
PAYMENT_WEBHOOK_SECRET=development-webhook-secret-replace-in-production

# Web client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
