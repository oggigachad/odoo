# PostgreSQL Database configuration
POSTGRES_USER=skyline_admin
POSTGRES_PASSWORD=skyline_secure_password_2026
POSTGRES_DB=skyline_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Rate-Limiting configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=skyline_redis_token_2026

# JWT Security configuration
JWT_SECRET=skyline_super_secure_jwt_secret_token_512_bits_key
JWT_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

# Rate Limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Google OAuth 2.0 Credentials


# --- Sign-up rules (comma separated; sub-domains match too) ---
STUDENT_EMAIL_DOMAINS=gmail.com,student.edu.in
ADMIN_EMAIL_DOMAINS=company.com,company.in

# --- First admin created by `python -m scripts.bootstrap` ---
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe@123

# --- Email (announcements, OTP codes, renewal and event reminders). Without these, emails are skipped ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com

# --- Razorpay (test keys from dashboard.razorpay.com). Webhook URL: <api>/api/v1/webhooks/razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# --- Public URL of the website. The event poster QR codes point here, so use your LAN IP / domain, not localhost, for phones ---
FRONTEND_URL=http://localhost:3000

# MinIO object storage (docker compose up -d minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=skyline_minio
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=skyline-media

# Dedicated key for ticket QR signatures (do not reuse JWT_SECRET)
TICKET_SIGNING_SECRET=change-me-64-hex

# The app reads REDIS_URL (the Docker Redis is published on 127.0.0.1:6380 because a native Windows Redis may already own 6379)
REDIS_URL=redis://:change-me@127.0.0.1:6380/0
